# MySQL Database Configuration (Copy to .env or set as OS environment variables)
# Never commit actual credentials or production secrets to version control.

DB_URL=jdbc:mysql://localhost:3306/logistics_db?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=root
DB_PASSWORD=your_mysql_password_here
SERVER_PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:4200


# JWT + demo login (change these in production — never commit real secrets)
JWT_SECRET=LogiTrackDevSecretKey-ChangeMeInProduction-0123456789abcdef
APP_AUTH_ADMIN_EMAIL=admin@logitrack.in
APP_AUTH_ADMIN_PASSWORD=Admin@123
APP_AUTH_DISPATCHER_EMAIL=dispatcher@logitrack.in
APP_AUTH_DISPATCHER_PASSWORD=Dispatch@123
APP_AUTH_VIEWER_EMAIL=viewer@logitrack.in
APP_AUTH_VIEWER_PASSWORD=View@123
